rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // 기기별 회원 문서의 room 값으로 이 목록에 참여한 사용자인지 판단합니다.
    function member(room) {
      return signedIn()
        && exists(/databases/$(database)/documents/todoMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/todoMembers/$(request.auth.uid)).data.room == room;
    }
    function validRoom(room) {
      return room is string && room.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }
    // 시연에서는 브랜드·용량이 고정된 세 상품만 가격 비교에 공개할 수 있습니다.
    function product(key) { return key in ['demo-milk-1l', 'demo-eggs-10', 'demo-water-2l']; }
    function validPurchase(p) {
      return p is map && p.keys().hasAll(['receiptId','itemId','productKey','store','purchasedOn','quantity','total','condition','share'])
        && p.keys().hasOnly(['receiptId','itemId','productKey','store','purchasedOn','quantity','total','condition','share'])
        && p.receiptId is string && p.receiptId.matches('^[a-zA-Z0-9-]{1,100}$')
        && p.itemId is string && p.itemId.size() <= 200
        && (product(p.productKey) || p.productKey == 'other')
        && p.store is string && p.store.size() > 0 && p.store.size() <= 80
        && p.store.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && p.purchasedOn is string && p.purchasedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p.quantity is int && p.quantity >= 1 && p.quantity <= 999
        && p.total is int && p.total >= 1 && p.total <= 100000000
        && p.condition is string && p.condition.size() <= 120
        && p.share is bool && (!p.share || product(p.productKey));
    }
    match /todoMembers/{user} {
      // 다른 사용자의 회원 정보 조회와 가입 목록 변경/삭제는 허용하지 않습니다.
      allow get: if signedIn() && request.auth.uid == user;
      allow create: if signedIn() && request.auth.uid == user
        && request.resource.data.keys().hasOnly(['room'])
        && validRoom(request.resource.data.room)
        // getAfter는 같은 트랜잭션에서 방금 생성하는 목록도 확인할 수 있습니다.
        && existsAfter(/databases/$(database)/documents/todoRooms/$(request.resource.data.room));
      allow list, update, delete: if false;
    }
    match /todoRooms/{room} {
      // 코드로 참여할 수 있도록 개별 조회만 열고 모든 목록의 나열은 막습니다.
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && validRoom(room)
        && request.resource.data.keys().hasOnly(['owner'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/todoMembers/$(request.auth.uid)).data.room == room;
      match /todos/{todo} {
        function validTodo() {
          let row = request.resource.data;
          return row.keys().hasAll(['id', 'title', 'completed', 'deleted', 'revision'])
            && row.keys().hasOnly(['id', 'title', 'completed', 'deleted', 'revision', 'quantity', 'purchase'])
            && row.id == todo && row.id.size() > 0 && row.id.size() <= 200
            && row.title is string && row.title.size() > 0 && row.title.size() <= 120
            && row.title.matches('[\\s\\S]*[^\\s][\\s\\S]*')
            && row.completed is bool && row.deleted is bool
            && row.revision is string && row.revision.matches('^[0-9]{16}:[a-z0-9]+$')
            && (!('quantity' in row) || (row.quantity is int && row.quantity >= 1 && row.quantity <= 999))
            && (!('purchase' in row) || (validPurchase(row.purchase) && row.completed && !row.deleted && !('quantity' in row)));
        }
        allow read: if member(room);
        allow create: if member(room) && validTodo();
        // 삭제도 deleted=true인 갱신으로 처리하고 문서 자체를 지우지는 않습니다.
        // 삭제 기록을 남겨야 오프라인 기기의 오래된 항목이 다시 살아나지 않습니다.
        // 구매 기록은 상품명과 동기화 버전만 수정할 수 있습니다. 금액·수량·날짜 등은 보존합니다.
        allow update: if member(room) && validTodo() && request.resource.data.revision > resource.data.revision
          && ((!('purchase' in resource.data) && !('purchase' in request.resource.data))
            || ('purchase' in resource.data && 'purchase' in request.resource.data
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'revision'])));
        allow delete: if false;
      }
    }
    match /productPrices/{key}/entries/{entry} {
      // 인증한 사용자는 다른 목록의 공개 가격도 볼 수 있지만 비공개 영수증에는 접근할 수 없습니다.
      // 기존 UID 포함 공개 문서는 새 버전에서 공개하지 않습니다.
      allow read: if false;
      function backedByPurchase() {
        let room = get(/databases/$(database)/documents/todoMembers/$(request.auth.uid)).data.room;
        let row = getAfter(/databases/$(database)/documents/todoRooms/$(room)/todos/$(entry)).data;
        let price = request.resource.data;
        return row.purchase.share && !row.deleted && row.purchase.productKey == key
          && price.store == row.purchase.store && price.purchasedOn == row.purchase.purchasedOn
          && price.quantity == row.purchase.quantity && price.total == row.purchase.total
          && price.condition == row.purchase.condition;
      }
      allow create: if signedIn() && product(key)
        && request.resource.data.keys().hasOnly(['productKey','store','purchasedOn','quantity','total','condition','owner'])
        && request.resource.data.productKey == key && request.resource.data.owner == request.auth.uid
        && backedByPurchase();
      // 공개한 값을 나중에 몰래 바꾸거나 다른 게시자의 값을 덮어쓰지 못하게 합니다.
      allow update, delete: if false;
    }
    // v4 개인 계정: 연결 코드를 아는 다른 UID에는 개인 자료를 공개하지 않습니다.
    function accountUser(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /accounts/{uid}/state/main {
      allow read: if accountUser(uid);
      allow create, update: if accountUser(uid)
        && request.resource.data.keys().hasOnly(['version','rows'])
        && request.resource.data.version == 4 && request.resource.data.rows is map;
      allow delete: if false;
    }
    match /priceOwners/{entry} {
      // 자신의 소유권만 읽고, 아직 없는 ID의 존재 여부 확인은 인증 사용자에게 허용합니다.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/priceOwners/$(entry)) || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create, update: if accountUser(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid','rowId'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.rowId == entry
        && (!exists(/databases/$(database)/documents/priceOwners/$(entry)) || resource.data.uid == request.auth.uid);
      allow delete: if accountUser(request.auth.uid) && resource.data.uid == request.auth.uid;
    }
    match /sharedPrices/{entry} {
      allow read: if signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
      function ownPrice() {
        let owner = getAfter(/databases/$(database)/documents/priceOwners/$(entry)).data;
        let row = get(/databases/$(database)/documents/accounts/$(request.auth.uid)/state/main).data.rows[entry];
        let p = row.purchase;
        let price = request.resource.data;
        return owner.uid == request.auth.uid && owner.rowId == entry && !row.deleted && p.share
          && price.keys().hasAll(['productKey','title','store','purchasedOn','registeredAt','quantity','total','condition','spec'])
          && price.keys().hasOnly(['productKey','title','store','purchasedOn','registeredAt','quantity','total','condition','spec'])
          && price.productKey == p.productKey && price.title == p.spec.identity
          && price.store == p.store && price.purchasedOn == p.purchasedOn && price.registeredAt == p.registeredAt
          && price.quantity == p.quantity && price.total == p.total && price.condition == p.condition && price.spec == p.spec
          && price.title is string && price.title.size() <= 50
          && price.store is string && price.store.size() > 0 && price.store.size() <= 50
          && price.purchasedOn is string && price.purchasedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && price.registeredAt is string && price.registeredAt.size() <= 30
          && price.condition is string && price.condition.size() <= 120
          && p.total is int && p.total >= 0 && p.total <= 9999999
          && p.quantity is int && p.quantity >= 1 && p.quantity <= 999
          && p.spec.keys().hasOnly(['identity','volume','unit','packCount','conditionKnown','allocated'])
          && p.spec.identity is string && p.spec.identity.size() > 0 && p.spec.identity.size() <= 50
          && p.spec.volume is number && p.spec.volume > 0 && p.spec.unit is string && p.spec.unit.size() > 0 && p.spec.unit.size() <= 12
          && p.spec.packCount is int && p.spec.packCount >= 1 && p.spec.packCount <= 999
          && p.spec.conditionKnown == true && p.spec.allocated == true;
      }
      allow create, update: if accountUser(request.auth.uid) && ownPrice();
      allow delete: if accountUser(request.auth.uid)
        && get(/databases/$(database)/documents/priceOwners/$(entry)).data.uid == request.auth.uid;
    }
    // 위에서 명시하지 않은 경로는 모두 기본 거부합니다.
  }
}
