        ],
        "summary": "다른 계정의 익명 제품 가격 조회",
        "operationId": "prices_v1_prices_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "productKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
